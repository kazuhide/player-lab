# Copy this file to `.env` (untracked) and fill in the values, then run
# `bash scripts/sync-env.sh` to fan the license keys out to the native apps.
# Never commit real keys — `.env` is gitignored; this template is not.
#
# This is the SINGLE credential file for every target (docs/SETUP.md):
#   web/E2E read it via Vite, the encoding scripts load it directly, and
#   scripts/sync-env.sh materializes the per-app files (iOS xcconfig, Android
#   local.properties, React Native .env). Non-secret encoding config (test
#   sources, output resource name) is committed in config/encoding.conf.
# Precedence everywhere: environment > .env > config/encoding.conf.

# ── Licenses (domain/bundle-locked, safe to embed client-side) ──────────────

# Bitmovin Player license key. Each app's domain / bundle ID must be
# allow-listed under this license in the Bitmovin dashboard, or the player
# refuses to start. This is NOT the account API key.
# Dashboard -> Player -> Licenses.
BITMOVIN_PLAYER_LICENSE_KEY=

# Optional — Bitmovin Analytics license key (§15). When set, every app's
# bundled analytics collector reports QoE to the Analytics dashboard, and the
# web app's query proxy reads this license's data. Empty = collectors stay off.
BITMOVIN_ANALYTICS_LICENSE_KEY=

# ── Account API keys (SECRET — server/CLI side only, never client-bundled) ──

# Bitmovin account API key — used by the encoding scripts (VOD test streams,
# the Live DVR channel, the multi-codec Per-Title run), the Bitmovin CLI, and
# the web app's Analytics query proxy (server-side middleware only).
# Get it from https://dashboard.bitmovin.com/account
BITMOVIN_API_KEY=

# Optional — a dedicated, least-privilege analytics-scoped API key for the
# query proxy. If unset, the proxy falls back to BITMOVIN_API_KEY above.
# BITMOVIN_ANALYTICS_API_KEY=

# Optional — organization-scoped accounts only (sent as X-Tenant-Org-Id by the
# encoding scripts and the analytics proxy). Replaces the former
# BITMOVIN_ANALYTICS_ORG_ID, which is still accepted.
# BITMOVIN_TENANT_ORG_ID=

# ── Encoder output storage (S3) ─────────────────────────────────────────────
# The scripts resolve the S3 *output resource* by name (BITMOVIN_OUTPUT_NAME in
# config/encoding.conf) and create it from these values only when it doesn't
# exist yet — "bootstrap once, reference by name". BUCKET/REGION are also used
# to print the public manifest URLs after a provision run.
BITMOVIN_OUTPUT_BUCKET=
BITMOVIN_OUTPUT_REGION=ap-northeast-1
BITMOVIN_OUTPUT_ACCESS_KEY=
BITMOVIN_OUTPUT_SECRET_KEY=
