{
  "name": "@player-lab/player-ui-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare:data": "node tools/precompute.ts",
    "check:data": "node tools/precompute.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "npm run check:data && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "bitmovin-player": "8.284.0",
    "bitmovin-player-ui": "4.23.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
