{
  "name": "@showcase/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @showcase/ui-shared build",
    "dev": "vite",
    "prebuild": "pnpm --filter @showcase/ui-shared build",
    "build": "tsc --noEmit && vite build",
    "prebuild:pages": "pnpm --filter @showcase/ui-shared build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "pretypecheck": "pnpm --filter @showcase/ui-shared build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @showcase/ui-shared build",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@bitmovin/player-web-x": "10.3.1",
    "@showcase/ui-shared": "workspace:*",
    "bitmovin-player": "8.281.0",
    "hls.js": "1.7.4",
    "shaka-player": "5.3.3"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
