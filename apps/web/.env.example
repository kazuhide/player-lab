# OPTIONAL, web-only overrides. Since the repo-root .env is the single source
# for credentials (docs/SETUP.md), this file is normally NOT needed:
# vite.config.ts maps BITMOVIN_PLAYER_LICENSE_KEY / BITMOVIN_ANALYTICS_LICENSE_KEY
# from the root .env into the client automatically.

# Web-specific license override (wins over the root .env mapping). License keys
# are domain-locked, so exposing them as VITE_ vars is fine.
# VITE_BITMOVIN_PLAYER_LICENSE_KEY=
# VITE_BITMOVIN_ANALYTICS_LICENSE_KEY=

# Override the live channel URLs (default to public reference live streams;
# point these at the dvr-showcase channel while encoding/live-dvr is running).
# VITE_LIVE_HLS_URL=
# VITE_LIVE_DASH_URL=

# The server-side Analytics QUERY proxy (/api/analytics/query) reads its SECRET
# key from the REPO-ROOT .env (BITMOVIN_API_KEY / BITMOVIN_ANALYTICS_API_KEY,
# optionally BITMOVIN_TENANT_ORG_ID) — server-side only, never VITE_.

# Feature demos require your own hosted media and WebVTT assets.
VITE_VOD_SPRITES_HLS_URL=
VITE_VOD_SPRITES_VTT_URL=
VITE_VOD_MULTIAUDIO_HLS_URL=
VITE_VOD_SUBTITLE_VTT_URL=
