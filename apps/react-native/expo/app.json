{
  "expo": {
    "name": "Player Lab React Native",
    "slug": "player-lab-react-native",
    "version": "0.1.1",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "bundleIdentifier": "com.playerlab.reactnative",
      "supportsTablet": true
    },
    "android": {
      "package": "com.playerlab.reactnative"
    },
    "plugins": [
      [
        "bitmovin-player-react-native",
        {
          "features": {
            "airPlay": true,
            "backgroundPlayback": true,
            "offline": true,
            "pictureInPicture": true,
            "googleCastSDK": {
              "appId": "FFE417E5",
              "android": "21.3.0",
              "ios": "4.8.4"
            }
          }
        }
      ],
      "./plugins/withSharedPlayerUi.cjs",
      "./plugins/withCastHost.cjs"
    ]
  }
}
