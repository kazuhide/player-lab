{
  "web": {
    "file": "apps/web/package.json",
    "pointer": "/dependencies/bitmovin-player"
  },
  "web-ui": {
    "file": "packages/ui-shared/package.json",
    "pointer": "/dependencies/bitmovin-player-ui"
  },
  "bitmovin-player-ui": {
    "file": "packages/ui-shared/package.json",
    "pointer": "/dependencies/bitmovin-player-ui"
  },
  "apple": {
    "file": "apps/ios/Package.resolved",
    "pointer": "/state/version",
    "identity": "player-ios"
  },
  "bitmovin-player-ios-core": {
    "file": "apps/ios/Package.resolved",
    "pointer": "/state/version",
    "identity": "player-ios-core"
  },
  "android": {
    "file": "apps/android/app/build.gradle.kts",
    "pattern": "implementation\\(\"com\\.bitmovin\\.player:player:([0-9]+\\.[0-9]+\\.[0-9]+)\\+jason\"\\)"
  },
  "react-native": {
    "file": "apps/react-native/package.json",
    "pointer": "/dependencies/bitmovin-player-react-native"
  },
  "vega": {
    "file": "apps/vega/package.json",
    "pointer": "/dependencies/bitmovin-player"
  }
}
