    "apple-ad-protocol-getters": {
      "kind": "input-contract",
      "en": {
        "reason": "These original configuration rows are getter-only advertising protocol members. The public declarations provide no setter for editing these members directly. The app edits the supported AdItem and AdSource inputs instead.",
        "action": "Use the advertising schedule editor for public ad inputs and inspect actual advertising events. A public mutable input contract would be needed to edit these protocol members directly."
      },
      "ja": {
        "reason": "元の設定一覧には、広告プロトコルの読み取り専用プロパティも含まれます。公開宣言にこの値を直接変更するsetterはありません。アプリでは対応するAdItemとAdSourceの入力を編集します。",
        "action": "広告スケジュールの編集画面と実際の広告イベントを使います。このプロトコルの値を直接編集するには、SDK側に変更可能な入力として公開される必要があります。"
      },
      "references": [
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/adbreakconfig/identifier",
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/adbreakconfig/position",
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/adbreakconfig/skippableafter",
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/adconfig/replacecontentduration",
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/adtagconfig/fallbacktags",
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/adtagconfig/tag"
      ]
    },
    "apple-system-background-session": {
      "kind": "input-contract",
      "en": {
        "reason": "The app forwards this API from UIApplicationDelegate using the background session identifier and completion handler supplied by the operating system. These lifecycle values cannot be produced by an arbitrary GUI command.",
        "action": "Start an eligible offline HLS download and let the operating system deliver the background-session callback. The implementation route is present; OS delivery is a separate execution condition."
      },
      "ja": {
        "reason": "このAPIは、OSから渡されたバックグラウンドセッションの識別子と完了処理をUIApplicationDelegateから転送します。任意のGUI操作ではOSのライフサイクルに属する値を生成できません。",
        "action": "対応するHLSのオフライン保存を開始し、OSのバックグラウンドセッション通知を受け取ります。転送処理は実装済みで、OSから通知される条件とは区別します。"
      },
      "references": [
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/offlinemanager/add(completionhandler:for:)"
      ]
    },
    "apple-sdk-internal-ad-lifecycle": {
      "kind": "input-contract",
      "en": {
        "reason": "These PlayerView methods receive an SDK-owned internal ad player and presentation lifecycle event. The app does not fabricate those objects or invoke the internal lifecycle manually.",
        "action": "Use a supported ad source and observe its real presentation callbacks. An arbitrary GUI invocation cannot substitute for the SDK-owned ad player lifecycle."
      },
      "ja": {
        "reason": "このPlayerViewメソッドは、SDKが所有する内部広告Playerと表示ライフサイクルのイベントを受け取ります。アプリはその実体を模造して内部処理を手動で呼び出しません。",
        "action": "対応する広告ソースを使い、実際の表示イベントを確認します。任意のGUI操作をSDK内部の広告Playerのライフサイクルの代わりにはできません。"
      },
      "references": [
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/playerview/oninternaladplayerwillunload(_:player:)",
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/playerview/oninternaladpresentationfinished(_:player:)",
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/playerview/oninternaladpresentationstarted(_:player:)"
      ]
    },
    "apple-tvos-empty-ima-configuration": {
      "kind": "input-contract",
      "en": {
        "reason": "AdvertisingConfig.ima is constructible on tvOS, but all three published mutable children of ImaAdvertisingConfig (preferredUiType, shouldPauseOnTap and adAttributionUiMode) are unavailable on tvOS. The parent has no applicable public input to edit.",
        "action": "Use the supported advertising schedule or the separate beforeInitialization callback with ImaSettings. Editing this parent requires an applicable mutable child in the tvOS SDK."
      },
      "ja": {
        "reason": "AdvertisingConfig.imaはtvOSでも生成できますが、ImaAdvertisingConfigの公開された変更可能な子項目preferredUiType・shouldPauseOnTap・adAttributionUiModeはすべてtvOSで利用できません。親にはtvOSで編集できる公開入力がありません。",
        "action": "対応する広告スケジュール、または別のbeforeInitializationとImaSettingsを使います。この親の編集にはtvOSで利用できる変更可能な子項目が必要です。"
      },
      "references": [
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/advertisingconfig/ima"
      ]
    },
    "apple-tvos-web-ui-renderer": {
      "kind": "input-contract",
      "en": {
        "reason": "The metadata value type is constructible, but the Bitmovin Web UI renderer that consumes it is unavailable in the public tvOS SDK. A detached metadata object does not establish an applied tvOS player setting.",
        "action": "Use SourceConfig.title and sourceDescription with a supported tvOS presentation. Applying this Web UI metadata requires a platform and SDK with that renderer."
      },
      "ja": {
        "reason": "メタデータの型自体は生成できますが、それを表示するBitmovin Web UIは公開tvOS SDKで利用できません。独立したメタデータを生成するだけでは、tvOS Playerへ設定が適用されたことになりません。",
        "action": "tvOSで対応する表示方式とSourceConfig.title・sourceDescriptionを使います。このWeb UI用メタデータの適用には、対応する描画機能が必要です。"
      },
      "references": [
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/bitmovinuserinterfacemetadata/sourcedescription",
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/bitmovinuserinterfacemetadata/title"
      ]
    },
    "apple-tvos-empty-view-tweaks": {
      "kind": "input-contract",
      "en": {
        "reason": "The parent PlayerView tweaks object exists on tvOS, but its only published mutable child, hidePlaybackControlsInPictureInPicture, is unavailable there. The default object has no tvOS input to edit.",
        "action": "Use the supported PictureInPictureConfig fields. A tvOS-compatible mutable child is required before this parent object can expose a meaningful customization."
      },
      "ja": {
        "reason": "PlayerViewのtweaksオブジェクトはtvOSにも存在しますが、公開された変更可能な子項目hidePlaybackControlsInPictureInPictureはtvOSで利用できません。既定のオブジェクトにはtvOSで編集できる入力がありません。",
        "action": "対応するPictureInPictureConfigの項目を使います。この親オブジェクトを編集可能にするには、tvOSで利用できる変更可能な子項目が必要です。"
      },
      "references": [
        "https://cdn.bitmovin.com/player/ios/3.128.0/documentation/bitmovinplayercore/playerviewconfig/tweaksconfig"
      ]
    }
  },
