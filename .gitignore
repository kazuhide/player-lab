# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Shared Web UI bundle synced into the native apps (build artifact from
# packages/ui-shared/dist — see scripts/sync-webui-bundle.sh). Generated, never committed.
apps/android/app/src/main/assets/bitmovinplayer-ui.js
apps/android/app/src/main/assets/bitmovinplayer-ui.css
apps/ios/WebUI/
apps/react-native/assets/webui/

# Test / coverage
coverage/

# Env & secrets — the Bitmovin license key lives here, never in the tree
.env
.env.*
!.env.example

# Per-app credential files generated by scripts/sync-env.sh are covered where
# they live: apps/ios/.gitignore (*.xcconfig), apps/android/.gitignore
# (local.properties), and the .env pattern above (apps/react-native/.env).

# Python bytecode (encoding scripts)
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
*.log
.idea/
.vscode/
