{
  "name": "player-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Bitmovin Player configuration and UI samples for Web and native platforms",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "sync:webui": "bash scripts/sync-webui-bundle.sh",
    "verify": "bash scripts/verify.sh",
    "check:publication": "python3 scripts/check-publication.py"
  }
}
